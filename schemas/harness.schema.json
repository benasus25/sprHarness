{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sprharness.dev/schemas/harness.schema.json",
  "title": "sprHarness harness.json",
  "type": "object",
  "required": ["version", "hosts"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "hosts": {
      "type": "object",
      "propertyNames": { "enum": ["claude", "cursor", "codex"] },
      "additionalProperties": {
        "type": "object",
        "required": ["configured"],
        "properties": {
          "configured": { "type": "boolean" },
          "configuredAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
